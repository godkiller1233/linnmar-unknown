import 'dotenv/config';
import { Client, GatewayIntentBits, Partials } from 'discord.js';
import fs from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';

const TOKEN = process.env.DISCORD_BOT_TOKEN;
const CHANNEL_ID = process.env.DISCORD_CHANNEL_ID;
const BASE_URL = process.env.PUBLIC_BASE_URL || 'http://localhost:3000';
const BRIDGE_SECRET = process.env.DISCORD_BRIDGE_SECRET || '';
const __dirname = path.dirname(fileURLToPath(import.meta.url));
const OUTBOX = path.join(__dirname, '..', 'data', 'discord-outbox.jsonl');
if (!TOKEN) { console.error('Set DISCORD_BOT_TOKEN in .env'); process.exit(1); }
const client = new Client({
  intents: [GatewayIntentBits.Guilds, GatewayIntentBits.GuildMessages, GatewayIntentBits.MessageContent],
  partials: [Partials.Channel]
});

client.once('ready', () => { console.log(`Discord bridge online as ${client.user.tag}`); setInterval(relayWebToDiscord, 1000); });

let relayOffset = 0;
async function relayWebToDiscord() {
  if (!CHANNEL_ID || !fs.existsSync(OUTBOX)) return;
  const content = fs.readFileSync(OUTBOX, 'utf8');
  const lines = content.split('\n').filter(Boolean);
  while (relayOffset < lines.length) {
    const msg = JSON.parse(lines[relayOffset++]);
    const channel = await client.channels.fetch(CHANNEL_ID).catch(() => null);
    if (channel?.isTextBased()) await channel.send(`**${msg.author.username}**: ${msg.text}`).catch(() => null);
  }
  if (relayOffset > 1000) { fs.writeFileSync(OUTBOX, lines.slice(relayOffset).join('\n') + (lines.slice(relayOffset).length ? '\n' : '')); relayOffset = 0; }
}

client.on('messageCreate', async (message) => {
  if (message.author.bot || !message.guild || (CHANNEL_ID && message.channelId !== CHANNEL_ID)) return;
  console.log(`[Discord] ${message.author.username}: ${message.content}`);
  await fetch(`${BASE_URL}/api/discord/incoming`, { method: 'POST', headers: { 'content-type': 'application/json', 'x-bridge-secret': BRIDGE_SECRET }, body: JSON.stringify({ author: message.author.username, text: message.content }) }).catch(() => null);
});
client.on('interactionCreate', async (i) => {
  if (!i.isChatInputCommand()) return;
  if (i.commandName === 'ping') await i.reply('Linnmar Unknown bridge is online.');
  if (i.commandName === 'status') await i.reply('Web server bridge status: online.');
});
client.login(TOKEN);
