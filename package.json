{
  "name": "linnmar-unknown",
  "version": "0.1.0",
  "private": true,
  "description": "Linnmar Unknown local-first chat server with Discord bridge, file sharing, voice rooms and admin console.",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "bot": "node bot/discord-bot.js",
