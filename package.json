    "discord.js": "^14.22.1",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "socket.io": "^4.8.1",
    "uuid": "^11.1.0",
    "pg": "^8.16.3",
    "@supabase/supabase-js": "^2.57.4"
  },
  "engines": {
    "node": ">=24.17.0 <25"
  }
