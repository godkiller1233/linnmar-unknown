# Required
ADMIN_USERNAME=unknown
ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
ADMIN_TAG=official
TERMS_VERSION=1.0
MAX_FILE_MB=50

# Render supplies PORT automatically. Do not hard-code it.

# Database: connect this to the Render Postgres DATABASE_URL in the Render dashboard.
# DATABASE_URL=postgresql://...

# Optional Discord bridge
DISCORD_BRIDGE_ENABLED=false
DISCORD_BRIDGE_SECRET=change-this-secret
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=

# Optional persistent file/profile storage via Supabase Storage.
# Create a public bucket named linnmar-files (or change SUPABASE_BUCKET).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=linnmar-files
